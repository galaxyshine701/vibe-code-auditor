{
  "name": "vca-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "MCP server for Vibe Code Auditor. Calls the audit API; keys come from the environment only.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
