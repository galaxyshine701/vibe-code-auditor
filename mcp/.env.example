# Copy this file to mcp/.env and fill it in. Never commit mcp/.env.
# Use ONLY keys of a throwaway TEST project.
VCA_API_URL=
VCA_ACCESS_CODE=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Set to yes only for a throwaway TEST project. Without it start_audit and request_retest refuse.
VCA_CONFIRM_TEST_PROJECT=
